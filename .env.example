# ----- Server -----
PORT=3000
NODE_ENV=development

# ----- MongoDB (required) -----
# Local Docker (docker compose up -d): the root user is created from these two
# values on first start, and MONGODB_URI must use the same credentials.
MONGO_ROOT_USERNAME=interviewhub
MONGO_ROOT_PASSWORD=change_me
MONGODB_URI=mongodb://interviewhub:change_me@127.0.0.1:27017/interviewhub?authSource=admin
# Atlas:  mongodb+srv://<user>:<pass>@<cluster>/interviewhub?retryWrites=true&w=majority

# ----- JWT (required) -----
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=1d

# ----- Redis (OPTIONAL) -----
# Leave REDIS_ENABLED=false to run fully in-memory (no Redis needed).
# Set to true and provide REDIS_URL to enable the Socket.io adapter + sorted-set leaderboard.
REDIS_ENABLED=false
REDIS_URL=

# ----- CORS -----
# Comma-separated browser origins allowed to call the API and open sockets.
# Explicit origins only ("*" is rejected at boot).
CORS_ORIGINS=http://localhost:5173

# ----- Uploads -----
# Public base URL used to build avatar links (should match where the server is reachable).
PUBLIC_BASE_URL=http://localhost:3000
MAX_AVATAR_SIZE_BYTES=2097152
