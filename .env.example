# ----- Server -----
PORT=3000
# Number of proxies in front of the app. 0 in local dev; 1 behind a single
# AWS load balancer. Never higher than the real count: clients could fake
# X-Forwarded-For and dodge per-IP rate limits.
TRUST_PROXY=0
NODE_ENV=development
# fatal, error, warn, info, debug or trace
LOG_LEVEL=info

# ----- MongoDB (required) -----
# Local Docker (docker compose up -d): the root user is created from these two
# values on first start, and MONGODB_URI must use the same credentials.
MONGO_ROOT_USERNAME=interviewhub
MONGO_ROOT_PASSWORD=change_me
MONGODB_URI=mongodb://interviewhub:change_me@127.0.0.1:27017/interviewhub?authSource=admin
# Atlas:  mongodb+srv://<user>:<pass>@<cluster>/interviewhub?retryWrites=true&w=majority

# ----- JWT (required) -----
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=15m
COOKIE_SECURE=true

# ----- Redis (OPTIONAL) -----
# Leave REDIS_ENABLED=false to run fully in-memory (no Redis needed).
# Set to true and provide REDIS_URL to enable the Socket.io adapter + sorted-set leaderboard.
REDIS_ENABLED=false
REDIS_URL=

# ----- CORS -----
# Comma-separated browser origins allowed to call the API and open sockets.
# Explicit origins only ("*" is rejected at boot).
CORS_ORIGINS=http://localhost:5173

# ----- Uploads -----
# Public base URL used to build avatar links (should match where the server is reachable).
PUBLIC_BASE_URL=http://localhost:3000
MAX_AVATAR_SIZE_BYTES=2097152

# ----- Calls (OPTIONAL) -----
# Without these, calls connect only when both people can reach each other
# directly (one network, or simple home routers). For everyone else, run
# coturn (docker compose --profile rtc up -d coturn) and point these at it.
# See guides/calls.md.
STUN_URLS=
TURN_URLS=
# Shared with coturn; at least 16 characters when TURN_URLS is set.
TURN_SECRET=
TURN_TTL_SECONDS=3600

# ----- Judge (separate process: npm run start:judge) -----
# The judge never reads this file's other settings. In production give it its
# own Mongo user that can only read contest_questions and read and update
# code_submissions. See guides/judge.md.
JUDGE_MONGODB_URI=mongodb://interviewhub:change_me@127.0.0.1:27017/interviewhub?authSource=admin
# JUDGE_WORKERS=3
