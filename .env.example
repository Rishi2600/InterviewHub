# ----- Server -----
PORT=3000
# Number of proxies in front of the app. 0 in local dev; 1 behind a single
# AWS load balancer. Never higher than the real count: clients could fake
# X-Forwarded-For and dodge per-IP rate limits.
TRUST_PROXY=0
NODE_ENV=development
# fatal, error, warn, info, debug or trace
LOG_LEVEL=info

# ----- MongoDB (required) -----
# Local Docker (docker compose up -d): the root user is created from these two
# values on first start, and MONGODB_URI must use the same credentials.
MONGO_ROOT_USERNAME=interviewhub
MONGO_ROOT_PASSWORD=change_me
MONGODB_URI=mongodb://interviewhub:change_me@127.0.0.1:27017/interviewhub?authSource=admin
# Atlas:  mongodb+srv://<user>:<pass>@<cluster>/interviewhub?retryWrites=true&w=majority

# ----- JWT (required) -----
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=15m
COOKIE_SECURE=true

# ----- Redis (OPTIONAL) -----
# Leave REDIS_ENABLED=false to run fully in-memory (no Redis needed).
# Set to true and provide REDIS_URL to enable the Socket.io adapter + sorted-set leaderboard.
REDIS_ENABLED=false
REDIS_URL=

# ----- CORS -----
# Comma-separated browser origins allowed to call the API and open sockets.
# Explicit origins only ("*" is rejected at boot).
CORS_ORIGINS=http://localhost:5173

# ----- Uploads -----
# Public base URL used to build avatar links (should match where the server is reachable).
PUBLIC_BASE_URL=http://localhost:3000
MAX_AVATAR_SIZE_BYTES=2097152

# ----- Calls (OPTIONAL) -----
# Without these, calls connect only when both people can reach each other
# directly (one network, or simple home routers). For everyone else, run
# coturn (docker compose --profile rtc up -d coturn) and point these at it.
# See guides/calls.md.
STUN_URLS=
TURN_URLS=
# Shared with coturn; at least 16 characters when TURN_URLS is set.
TURN_SECRET=
TURN_TTL_SECONDS=3600

# ----- Judge (separate process: npm run start:judge) -----
# The judge never reads this file's other settings. In production give it its
# own Mongo user that can only read contest_questions and read and update
# code_submissions. See guides/judge.md.
JUDGE_MONGODB_URI=mongodb://interviewhub:change_me@127.0.0.1:27017/interviewhub?authSource=admin
# JUDGE_WORKERS=3

# ----- AI practice interviews (OPTIONAL) -----
# Without a key, AI practice is switched off. Use a free Groq key with Zero
# Data Retention on (console.groq.com, Settings > Data Controls), and no card.
# See guides/ai-practice.md.
GROQ_API_KEY=
# Tried in order: when one hits its limit, the next takes over.
AI_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b
# The app's daily budget across all models, under Groq's free limits (each
# model: 1,000 requests and 200,000 tokens a day, 8,000 tokens a minute, and
# no prompt caching). A typical 20-answer interview uses 40,000 to 50,000
# tokens, so two models carry about 8 to 10 interviews a day.
AI_DAILY_REQUESTS=1800
AI_DAILY_TOKENS=360000
# Set aside when an interview starts, about what a full-length one uses, so
# a started interview can always finish. The unused rest is given back.
AI_TOKENS_PER_INTERVIEW=100000
# Interviews running at once, to stay under the per-minute limits.
AI_MAX_RUNNING=3

# ----- Interview prep (OPTIONAL) -----
# Drills and the AI coach. Its own key if set (else GROQ_API_KEY). A key from
# the same Groq organisation shares its limits, so prep is kept apart by its
# model instead: one practice never uses. See guides/prep.md.
GROQ_API_KEY_PREP=
AI_PREP_MODELS=qwen/qwen3.8-27b
# Prep's daily budget, under the model's free limits.
AI_PREP_DAILY_REQUESTS=900
AI_PREP_DAILY_TOKENS=180000
# Set aside when a coach session starts; the unused rest is given back.
AI_PREP_TOKENS_PER_COACH=50000
# Coach sessions running at once.
AI_PREP_MAX_RUNNING=2
